{
  "name": "@mada-ai/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "sh -c 'while :; do next dev --turbopack --port 3000 --hostname 0.0.0.0; echo \"[dev] next exited ($?), restarting in 1s\"; sleep 1; done' --",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mada-ai/agent-core": "workspace:*",
    "@mada-ai/auth": "workspace:*",
    "@mada-ai/db": "workspace:*",
    "@mada-ai/models": "workspace:*",
    "@mada-ai/search": "workspace:*",
    "@mada-ai/shared": "workspace:*",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "next": "^15.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
